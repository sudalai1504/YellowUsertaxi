<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- MAIN CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Google Map Fullscreen -->
        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hamburger Icon -->
        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="35dp"
            android:layout_height="30dp"
            android:layout_margin="16dp"
            android:background="@android:color/transparent"
            android:contentDescription="Menu Icon"
            android:src="@drawable/view"
            android:tint="@color/pink"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Bottom Card -->
        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_margin="12dp"
            android:background="@drawable/top_card_bg"
            android:elevation="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3">

                <LinearLayout
                    android:id="@+id/tabLocal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/indicap" />

                    <TextView
                        android:id="@+id/textLocal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Local"
                        android:textColor="#7A7A7A"
                        android:textStyle="bold"
                        android:paddingVertical="4dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabRental"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/psedn" />

                    <TextView
                        android:id="@+id/textRental"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rental"
                        android:textColor="#7A7A7A"
                        android:textStyle="bold"
                        android:paddingVertical="4dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabOutstation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/psuv" />

                    <TextView
                        android:id="@+id/textOutstation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Outstation"
                        android:textColor="#7A7A7A"
                        android:textStyle="bold"
                        android:paddingVertical="4dp"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Scrollable Package Options -->
            <HorizontalScrollView
                android:id="@+id/packageScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/packageLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/oneHr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 hr\n10 Kms"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/twoHrs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 hrs\n20 Kms"
                        android:gravity="center"
                        android:padding="12dp"
                        android:layout_marginStart="8dp"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/threeHrs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 hrs\n30 Kms"
                        android:gravity="center"
                        android:padding="12dp"
                        android:layout_marginStart="8dp"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/fourHrs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 hrs\n40 Kms"
                        android:gravity="center"
                        android:padding="12dp"
                        android:layout_marginStart="8dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Pickup Location -->
            <LinearLayout
                android:id="@+id/pickupLayout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:background="@drawable/input_bg"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/search"
                   />

                <EditText
                    android:id="@+id/etTo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Pickup Location"
                    android:background="@null"
                    android:paddingStart="10dp"
                    android:textColor="#000"
                    android:textColorHint="#999"
                    android:textSize="14sp"
                    android:focusable="false"
                    android:clickable="true" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SIDE NAVIGATION MENU -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        app:itemTextColor="@color/black"
        app:itemIconTint="@color/pink"
        app:headerLayout="@layout/nav_header" />

</androidx.drawerlayout.widget.DrawerLayout>
